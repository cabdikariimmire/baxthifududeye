PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ai_research_assistant
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_min_16_characters_here

# Frontend Client URL
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=منصة بحوثي الأكاديمية <noreply@academic.edu>

# AI Configuration (OpenRouter NVIDIA Model)
AI_PROVIDER=openrouter
AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free
AI_API_KEY=your_api_key_here

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
